# --- Storefront: copy to .env.local. Leave NEXT_PUBLIC_API_URL empty to use built-in demo data. ---
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# --- docker compose: copy to .env (never commit .env) ---
DB_PASSWORD=ecommerce

# Required. Generate with:  openssl rand -hex 32
JWT_SECRET=

# Optional: first admin account, created on startup if both are set. Pick your own strong password.
ADMIN_EMAIL=
ADMIN_PASSWORD=
